# KubeWatch Environment Variables
# Copy this file to .env and fill in values

# Application
SPRING_APPLICATION_NAME=kubewatch-app
SERVER_PORT=8080

# Grafana (only needed if changing defaults)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=kubewatch-admin

# Alertmanager Webhook (optional - for external notifications)
# ALERTMANAGER_WEBHOOK_URL=http://your-webhook-endpoint:9095/webhook

# SMTP (optional - for email alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_TO=admin@example.com
